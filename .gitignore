# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file
local.properties

# Android Studio
*.iml
.idea/
.DS_Store

# NDK
obj/
.cxx/

# IntelliJ
*.iws
/out/

# Keystore files
*.jks
*.keystore
# Exception: the debug keystore is intentionally committed so every CI build
# (and yours locally) signs APKs with the same cert. Without it, every CI
# build produces an APK that conflicts with the installed app on update.
# The keystore uses Android's well-known debug defaults — not sensitive.
!app/debug.keystore

# External native build folder
.externalNativeBuild/

# Google Services (if added later)
google-services.json

# Version control
vcs.xml

# Lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
